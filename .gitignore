```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.env/
.venv/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Database / runtime data
*.db
*.sqlite
crawler.db
results.jsonl
organized_results.json
*.jsonl

# Logs
*.log
logs/

# Telegram sessions
*.session
*.session-journal

# Temporary processing
leak_processing_tmp/
downloads/
tmp/
temp/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Archive files
*.zip
*.7z
*.rar

# Git internals (safety)
.git/
```
